<UserControl x:Class="EduFlow.WPF.Views.CoursesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid Margin="0,0,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" />
        <RowDefinition Height="16" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>
      <materialDesign:Card Style="{StaticResource PageCard}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding NewCommand}" ToolTip="Thêm Khóa Học"
              Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
              <materialDesign:PackIcon Kind="Plus" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" />
            </Button>
            <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
              Chương Trình Đào Tạo · <Run Text="{Binding Courses.Count, Mode=OneWay}" /> Khóa
            </TextBlock>
          </DockPanel>
          <DataGrid ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}" VerticalContentAlignment="Center">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Khóa Học" Width="1.8*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Normal" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Code}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Nhóm" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center" DataContext="{Binding Category}">
                      <TextBlock Style="{StaticResource BadgeText}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Số Buổi" Width="75">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding SessionCount}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Phí / Tháng" Width="115">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding MonthlyFee, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Phí Trọn Gói" Width="115">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding TuitionFee, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Mô Tả" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center" DataContext="{Binding IsActive}">
                      <TextBlock FontSize="12" FontWeight="Normal" Foreground="{Binding Converter={StaticResource StatusForeground}}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Ngừng Mở" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding}" Value="True">
                                <Setter Property="Text" Value="Đang Mở" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Thao Tác" Width="100"
                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" ToolTip="Chỉnh Sửa">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" />
                      </Button>
                      <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" ToolTip="Xóa">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </materialDesign:Card>
      <materialDesign:Card Grid.Row="2" Style="{StaticResource PageCard}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding NewRoomCommand}" ToolTip="Thêm Phòng Học"
              Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
              <materialDesign:PackIcon Kind="Plus" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" />
            </Button>
            <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
              Danh Sách Phòng Học · <Run Text="{Binding Rooms.Count, Mode=OneWay}" /> Phòng
            </TextBlock>
          </DockPanel>
          <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" VerticalContentAlignment="Center">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Tên Phòng" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Sức Chứa" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Capacity}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center" DataContext="{Binding IsActive}">
                      <TextBlock FontSize="12" FontWeight="Normal" Foreground="{Binding Converter={StaticResource StatusForeground}}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Ngừng Dùng" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding}" Value="True">
                                <Setter Property="Text" Value="Đang Dùng" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Thao Tác" Width="100"
                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                        Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" ToolTip="Chỉnh Sửa">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" />
                      </Button>
                      <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                        Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}" ToolTip="Xóa">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </materialDesign:Card>
    </Grid>
    <materialDesign:Card Grid.Column="1" Style="{StaticResource PageCard}" Width="350"
      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CancelEditCommand}" ToolTip="Đóng">
            <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
          </Button>
          <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBox Text="{Binding Code}" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Mã Khóa Học *" Margin="0,0,0,18" />
        <TextBox Text="{Binding Name}" materialDesign:HintAssist.Hint="Tên Khóa Học *" Margin="0,0,0,18" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" materialDesign:HintAssist.Hint="Nhóm Khóa Học *" Margin="0,0,0,18">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding SessionCount}" materialDesign:HintAssist.Hint="Số Buổi *" Margin="0,0,0,18" />
        <TextBox Text="{Binding MonthlyFee, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Học Phí Theo Tháng *" Margin="0,0,0,18" />
        <TextBox Text="{Binding TuitionFee, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Học Phí Trọn Gói *" Margin="0,0,0,18" />
        <TextBox Text="{Binding Description}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
          materialDesign:HintAssist.Hint="Mô Tả" Margin="0,0,0,16" />
        <CheckBox Content="Đang Mở Lớp" IsChecked="{Binding IsActive}" Margin="0,0,0,20" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" ToolTip="Lưu" HorizontalAlignment="Right">
          <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" />
        </Button>
      </StackPanel>
    </materialDesign:Card>
    <materialDesign:Card Grid.Column="1" Style="{StaticResource PageCard}" Width="350"
      Visibility="{Binding IsEditingRoom, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CancelEditRoomCommand}" ToolTip="Đóng">
            <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
          </Button>
          <TextBlock Text="{Binding RoomFormTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBox Text="{Binding RoomName}" materialDesign:HintAssist.Hint="Tên Phòng Học *" Margin="0,0,0,20" />
        <TextBox Text="{Binding RoomCapacity}" materialDesign:HintAssist.Hint="Sức Chứa Tối Đa *" Margin="0,0,0,20" />
        <CheckBox Content="Đang Sử Dụng" IsChecked="{Binding RoomIsActive}" Margin="0,0,0,24" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveRoomCommand}" ToolTip="Lưu" HorizontalAlignment="Right">
          <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" />
        </Button>
      </StackPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>