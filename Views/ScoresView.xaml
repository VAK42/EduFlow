<UserControl x:Class="EduFlow.WPF.Views.ScoresView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <materialDesign:Card Style="{StaticResource PageCard}" Padding="20,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding SaveCommand}" ToolTip="Lưu Bảng Điểm"
          VerticalAlignment="Center" Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibility}}">
          <materialDesign:PackIcon Kind="ContentSave" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" />
        </Button>
        <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center"
          Style="{StaticResource ToolbarComboBox}" materialDesign:HintAssist.Hint="Lớp Đang Học Hoặc Đã Kết Thúc" />
      </DockPanel>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="2" Style="{StaticResource PageCard}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
          Bảng Điểm · <Run Text="{Binding Rows.Count, Mode=OneWay}" /> Học Viên
        </TextBlock>
        <TextBlock DockPanel.Dock="Top" Text="Chọn Lớp Đang Học Hoặc Đã Kết Thúc Để Nhập Điểm" Style="{StaticResource MutedText}"
          Visibility="{Binding SelectedClass, Converter={StaticResource NullToVisible}}" Margin="0,0,0,10" />
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RuleText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="False" VerticalContentAlignment="Center">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Học Viên" Width="1.8*" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Avatar}" Margin="0,0,10,0" VerticalAlignment="Center">
                      <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding StudentName}" FontWeight="Normal" />
                      <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{Binding StudentCode, Mode=OneWay}" /> · <Run Text="{Binding Phone, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Quá Trình · 40% *" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Style="{StaticResource ScoreTextBox}" Text="{Binding ProcessScoreText, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding DataContext.CanSave, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBool}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Cuối Kỳ · 60% *" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Style="{StaticResource ScoreTextBox}" Text="{Binding FinalScoreText, UpdateSourceTrigger=PropertyChanged}"
                    IsReadOnly="{Binding DataContext.CanSave, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBool}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Điểm Tổng" Width="110" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TotalScore, StringFormat={}{0:0.00}, TargetNullValue='—'}"
                    FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Chuyên Cần" Width="130" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AttendanceRate, StringFormat={}{0}%}" FontSize="12" HorizontalAlignment="Center" />
                    <ProgressBar Value="{Binding AttendanceRate, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Kết Quả" Width="140" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ResultText}" Value="Đạt">
                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ResultText}" Value="Dự Kiến Đạt">
                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ResultText}" Value="Không Đạt">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ResultText}" Value="Dự Kiến Không Đạt">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ResultText}" Value="Chưa Đủ Điểm">
                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="Normal">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultText}" Value="Đạt">
                              <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultText}" Value="Dự Kiến Đạt">
                              <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultText}" Value="Không Đạt">
                              <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultText}" Value="Dự Kiến Không Đạt">
                              <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ResultText}" Value="Chưa Đủ Điểm">
                              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>