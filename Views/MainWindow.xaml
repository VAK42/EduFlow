<Window x:Class="EduFlow.WPF.Views.MainWindow" Language="vi-VN"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:vm="clr-namespace:EduFlow.WPF.ViewModels"
  xmlns:views="clr-namespace:EduFlow.WPF.Views"
  Title="{Binding Title}" Height="800" Width="1360" MinWidth="1024" MinHeight="640"
  WindowStartupLocation="CenterScreen" WindowState="Maximized"
  Background="{StaticResource BackgroundBrush}" TextElement.FontSize="14">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScheduleViewModel}"><views:ScheduleView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StudentsViewModel}"><views:StudentsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScoresViewModel}"><views:ScoresView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CoursesViewModel}"><views:CoursesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClassesViewModel}"><views:ClassesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TuitionFeeViewModel}"><views:TuitionFeeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SalaryViewModel}"><views:SalaryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AttendanceViewModel}"><views:AttendanceView /></DataTemplate>
    <CollectionViewSource x:Key="GroupedMenu" Source="{Binding MenuItems}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Background="{StaticResource SidebarBrush}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,20,24,10">
        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrandGradient}">
          <materialDesign:PackIcon Kind="School" Width="22" Height="22" Foreground="White"
            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="EduFlow" Foreground="White" FontSize="18" FontWeight="Normal" />
          <TextBlock Text="Ngoại Ngữ · Tin Học" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" />
        </StackPanel>
      </StackPanel>
      <Button DockPanel.Dock="Bottom" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding LogoutCommand}"
        HorizontalContentAlignment="Left" Foreground="#EF4444" Margin="14,10,14,16" Padding="16,10">
        <StackPanel Orientation="Horizontal">
          <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" VerticalAlignment="Center" Foreground="#EF4444" />
          <TextBlock Text="Đăng Xuất" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Normal" Foreground="#EF4444" />
        </StackPanel>
      </Button>
      <ListBox ItemsSource="{Binding Source={StaticResource GroupedMenu}}" SelectedItem="{Binding SelectedMenu}"
        Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="#475569" FontSize="11" FontWeight="Normal" Margin="26,10,0,4" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource Avatar}" Margin="0,0,10,0">
              <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding UserName}" FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="{Binding UserRoleText}" Style="{StaticResource MutedText}" />
            </StackPanel>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentPage.Title}" FontSize="18" FontWeight="Normal" Foreground="{StaticResource TextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <materialDesign:PackIcon Kind="CalendarToday" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TodayText}" Style="{StaticResource MutedText}" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
        Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
      <Grid>
        <ContentControl Content="{Binding CurrentPage}" Margin="28,20,28,24" />
        <materialDesign:Snackbar MessageQueue="{Binding MessageQueue}" HorizontalAlignment="Center" />
      </Grid>
    </DockPanel>
  </Grid>
</Window>