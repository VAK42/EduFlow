<UserControl x:Class="EduFlow.WPF.Views.TuitionFeeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <materialDesign:Card Style="{StaticResource PageCard}" Margin="0,0,12,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}"
              materialDesign:HintAssist.Hint="Tìm Học Viên..." Width="150" Margin="0,0,8,0" VerticalAlignment="Center" />
            <DatePicker x:Name="FilterDatePicker" SelectedDate="{Binding FilterDate}" Style="{StaticResource ToolbarDatePicker}" materialDesign:HintAssist.Hint="Kỳ Thu" Width="145" Margin="0,0,6,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ClearFilterDateCommand}" ToolTip="Xem Tất Cả Kỳ Thu" Margin="0,0,8,0">
              <materialDesign:PackIcon Kind="CalendarRemoveOutline" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
            </Button>
            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding NewCommand}" ToolTip="Thêm Học Phí">
              <materialDesign:PackIcon Kind="Plus" Foreground="{StaticResource PrimaryBrush}" Width="22" Height="22" />
            </Button>
          </StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
            <Run Text="{Binding Title, Mode=OneWay}" /> · <Run Text="{Binding TuitionFees.Count, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <DataGrid ItemsSource="{Binding TuitionFees}" SelectedItem="{Binding SelectedFee}" VerticalContentAlignment="Center">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Học Viên" Width="1.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Avatar}" Margin="0,0,8,0" VerticalAlignment="Center">
                      <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Student.FullName}" FontWeight="Normal" />
                      <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{Binding Student.Code, Mode=OneWay}" /> · <Run Text="{Binding Student.Phone, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Lớp Học" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ClassRoom.Code, TargetNullValue=Chưa Xếp Lớp}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Hình Thức" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Badge}" VerticalAlignment="Center" DataContext="{Binding FeeType}">
                    <TextBlock Style="{StaticResource BadgeText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Kỳ Học" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Số Tiền" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Trạng Thái" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPaid}" Value="False">
                            <Setter Property="Background" Value="#FEF3C7" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="12" FontWeight="Normal">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#15803D" />
                          <Setter Property="Text" Value="Đã Đóng" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaid}" Value="False">
                              <Setter Property="Foreground" Value="#B45309" />
                              <Setter Property="Text" Value="Chưa Đóng" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                              <Setter Property="Foreground" Value="#B91C1C" />
                              <Setter Property="Text" Value="Quá Hạn" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ngày Thu" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PaidAt, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ghi Chú" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Note}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Thao Tác" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                      Command="{Binding DataContext.TogglePaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Đánh Dấu Đã / Chưa Đóng">
                      <materialDesign:PackIcon Kind="CashCheck" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                      Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Chỉnh Sửa">
                      <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                      Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Xóa">
                      <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </materialDesign:Card>
    <materialDesign:Card Grid.Column="1" Style="{StaticResource PageCard}" Width="350"
      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CancelEditCommand}" ToolTip="Đóng">
            <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
          </Button>
          <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ComboBox ItemsSource="{Binding EligibleStudents}" SelectedValue="{Binding EditStudentId}" SelectedValuePath="Id"
          materialDesign:HintAssist.Hint="Học Viên *" Margin="0,0,0,22">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding FullName, Mode=OneWay}" /> · <Run Text="{Binding Code, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding EligibleClasses}" SelectedValue="{Binding EditClassRoomId}" SelectedValuePath="Id"
          materialDesign:HintAssist.Hint="Lớp Học" Margin="0,0,0,22">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Code, Mode=OneWay}" /> · <Run Text="{Binding Course.Name, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding FeeTypes}" SelectedItem="{Binding EditFeeType}"
          materialDesign:HintAssist.Hint="Hình Thức Thu *" Margin="0,0,0,22">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <DatePicker x:Name="EditorDatePicker" SelectedDate="{Binding EditPeriodDate}" materialDesign:HintAssist.Hint="Kỳ Thu *"
          IsEnabled="{Binding IsMonthly}" Margin="0,0,0,22" />
        <TextBox Text="{Binding EditAmount, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Số Tiền Học Phí *"
          IsReadOnly="True" Margin="0,0,0,22" materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="CashLock" />
        <TextBox Text="{Binding EditNote}" materialDesign:HintAssist.Hint="Ghi Chú" Margin="0,0,0,26" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" ToolTip="Lưu" HorizontalAlignment="Right">
          <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" />
        </Button>
      </StackPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>