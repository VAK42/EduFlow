<UserControl x:Class="EduFlow.WPF.Views.DashboardView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <UserControl.Resources>
    <Style x:Key="KpiValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <Style x:Key="KpiIcon" TargetType="Border">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Tình Hình Trung Tâm Hôm Nay" Style="{StaticResource PageSubtitle}" />
      <UniformGrid Columns="4" Margin="0,0,0,20">
        <materialDesign:Card Style="{StaticResource PageCard}" Margin="0,0,16,0">
          <StackPanel>
            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource PrimarySoftBrush}">
              <materialDesign:PackIcon Kind="AccountSchool" Width="24" Height="24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Summary.ActiveStudents, FallbackValue=0}" Style="{StaticResource KpiValue}" />
            <TextBlock Text="Học Viên Đang Theo Học" Style="{StaticResource MutedText}" />
          </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Style="{StaticResource PageCard}" Margin="0,0,16,0">
          <StackPanel>
            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource VioletSoftBrush}">
              <materialDesign:PackIcon Kind="GoogleClassroom" Width="24" Height="24" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Style="{StaticResource KpiValue}">
              <Run Text="{Binding Summary.RunningClasses, Mode=OneWay, FallbackValue=0}" /><Run Text=" Lớp" FontSize="14" FontWeight="Normal" />
            </TextBlock>
            <TextBlock Style="{StaticResource MutedText}">
              <Run Text="Đang Học · " /><Run Text="{Binding Summary.OpenClasses, Mode=OneWay, FallbackValue=0}" /><Run Text=" Lớp Đang Tuyển Sinh" />
            </TextBlock>
          </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Style="{StaticResource PageCard}" Margin="0,0,16,0" Visibility="{Binding Summary.CanSeeFinance, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <StackPanel>
            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource SuccessSoftBrush}">
              <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Summary.CollectedThisMonth, StringFormat={}{0:N0} đ, FallbackValue=0 đ}" Style="{StaticResource KpiValue}" />
            <TextBlock Style="{StaticResource MutedText}">
              <Run Text="Tổng Thu Tháng Này · " /><Run Text="{Binding CollectionTrend, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Style="{StaticResource PageCard}" Visibility="{Binding Summary.CanSeeFinance, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <StackPanel>
            <Border Style="{StaticResource KpiIcon}" Background="{StaticResource DangerSoftBrush}">
              <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Summary.TotalDebt, StringFormat={}{0:N0} đ, FallbackValue=0 đ}" Style="{StaticResource KpiValue}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Style="{StaticResource MutedText}">
              <Run Text="Công Nợ Học Phí · " /><Run Text="{Binding Summary.DebtorCount, Mode=OneWay, FallbackValue=0}" /><Run Text=" Học Viên Còn Nợ" />
            </TextBlock>
          </StackPanel>
        </materialDesign:Card>
      </UniformGrid>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <materialDesign:Card Style="{StaticResource PageCard}" Visibility="{Binding Summary.CanSeeFinance, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <StackPanel>
            <TextBlock Text="Tổng Thu Học Phí 6 Tháng Gần Nhất" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Tổng Học Phí Đã Thu Theo Tháng · Số Liệu Thực Thu Của Trung Tâm" Style="{StaticResource MutedText}" Margin="0,-6,0,8" />
            <ItemsControl ItemsSource="{Binding CollectionBars}" Height="220">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="10,0">
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" HorizontalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    <StackPanel VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Center" FontSize="11" FontWeight="Normal"
                        Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                      <Border Height="{Binding BarHeight}" CornerRadius="6,6,0,0" MaxWidth="56">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#BFDBFE" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Border.ToolTip>
                          <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} đ}" />
                        </Border.ToolTip>
                      </Border>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Grid.Column="2" Style="{StaticResource PageCard}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Sĩ Số Các Lớp" Style="{StaticResource SectionTitle}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
              <ItemsControl ItemsSource="{Binding Summary.ClassFill}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="8,0,0,0">
                          <Run Text="{Binding Students, Mode=OneWay}" />/<Run Text="{Binding MaxStudents, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontWeight="Normal" FontSize="13" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding CourseName, Mode=OneWay}" /> · <Run Text="{Binding ClassCode, Mode=OneWay}" />
                        </TextBlock>
                      </DockPanel>
                      <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6,0,0"
                        materialDesign:TransitionAssist.DisableTransitions="True" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </materialDesign:Card>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <materialDesign:Card Style="{StaticResource PageCard}">
          <StackPanel>
            <TextBlock Text="Lịch Học Hôm Nay" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Hôm Nay Không Có Buổi Học Nào" Style="{StaticResource MutedText}"
              Visibility="{Binding Summary.TodayLessons.Count, Converter={StaticResource ZeroToVisible}, FallbackValue=Collapsed}" />
            <ItemsControl ItemsSource="{Binding Summary.TodayLessons}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel>
                        <TextBlock Text="{Binding CourseName}" FontWeight="Normal" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedText}">
                          <Run Text="{Binding ClassCode, Mode=OneWay}" /> · Phòng <Run Text="{Binding RoomName, Mode=OneWay}" /> · <Run Text="{Binding TeacherName, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </materialDesign:Card>
        <materialDesign:Card Grid.Column="2" Style="{StaticResource PageCard}" Visibility="{Binding Summary.CanSeeFinance, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <StackPanel>
            <TextBlock Text="Học Viên Còn Nợ Học Phí Nhiều Nhất" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Không Có Học Viên Nào Còn Nợ" Style="{StaticResource MutedText}"
              Visibility="{Binding Debts.Count, Converter={StaticResource ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Debts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Debt, StringFormat={}{0:N0} đ}" Foreground="{StaticResource DangerBrush}"
                        FontWeight="Normal" VerticalAlignment="Center" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StudentName}" FontWeight="Normal" FontSize="13" />
                        <TextBlock Style="{StaticResource MutedText}">
                          <Run Text="{Binding ClassCode, Mode=OneWay}" /> · <Run Text="{Binding Phone, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </materialDesign:Card>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>