<UserControl x:Class="EduFlow.WPF.Views.AttendanceView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  x:Name="Root">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <materialDesign:Card Style="{StaticResource PageCard}" Padding="20,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibility}}">
          <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding MarkAllPresentCommand}" ToolTip="Tất Cả Có Mặt" Margin="0,0,4,0">
            <materialDesign:PackIcon Kind="CheckAll" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" />
          </Button>
          <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding SaveCommand}" ToolTip="Lưu Điểm Danh">
            <materialDesign:PackIcon Kind="ContentSave" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Width="340" VerticalAlignment="Center"
            Style="{StaticResource ToolbarComboBox}" materialDesign:HintAssist.Hint="Lớp" />
          <ComboBox ItemsSource="{Binding Lessons}" SelectedItem="{Binding SelectedLesson}" Width="260" Margin="12,0,0,0" VerticalAlignment="Center"
            Style="{StaticResource ToolbarComboBox}" materialDesign:HintAssist.Hint="Buổi Học" />
        </StackPanel>
      </DockPanel>
    </materialDesign:Card>
    <materialDesign:Card Grid.Row="2" Style="{StaticResource PageCard}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
          Phiếu Điểm Danh · <Run Text="{Binding Rows.Count, Mode=OneWay}" /> Học Viên
        </TextBlock>
        <TextBlock DockPanel.Dock="Top" Text="Chọn Lớp &amp; Buổi Học Để Điểm Danh" Style="{StaticResource MutedText}"
          Visibility="{Binding SelectedLesson, Converter={StaticResource NullToVisible}}" Margin="0,0,0,10" />
        <TextBox DockPanel.Dock="Top" Text="{Binding Content}" Margin="0,0,0,14" IsEnabled="{Binding CanSave}"
          materialDesign:HintAssist.Hint="Nội Dung Buổi Học · Bài Đã Dạy *" />
        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="False" VerticalContentAlignment="Center">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Học Viên" Width="1.8*" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Avatar}" Margin="0,0,10,0" VerticalAlignment="Center">
                      <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding StudentName}" FontWeight="Normal" />
                      <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{Binding StudentCode, Mode=OneWay}" /> · <Run Text="{Binding Phone, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Trạng Thái" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding DataContext.Statuses, ElementName=Root}" Margin="0" Padding="8,4"
                    Style="{StaticResource MaterialDesignComboBox}" VerticalAlignment="Center"
                    SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Badge}" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource BadgeText}" />
                        </Border>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ghi Chú" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0"
                    materialDesign:HintAssist.Hint="Ghi Chú Điểm Danh" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Chuyên Cần Trước Đó" Width="170" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AttendanceRate, StringFormat={}{0}%}" FontSize="12" HorizontalAlignment="Center" />
                    <ProgressBar Value="{Binding AttendanceRate, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>