<UserControl x:Class="EduFlow.WPF.Views.SalaryView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <materialDesign:Card Style="{StaticResource PageCard}" Margin="0,0,12,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <DatePicker x:Name="FilterDatePicker" SelectedDate="{Binding FilterDate}" materialDesign:HintAssist.Hint="Kỳ Lương" Width="145" Margin="0,0,6,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ClearFilterDateCommand}" ToolTip="Xem Tất Cả Kỳ Lương" Margin="0,0,10,0">
              <materialDesign:PackIcon Kind="CalendarRemoveOutline" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
            </Button>
            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding NewCommand}" ToolTip="Thêm Phiếu Lương"
              Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
              <materialDesign:PackIcon Kind="Plus" Foreground="{StaticResource PrimaryBrush}" Width="22" Height="22" />
            </Button>
          </StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
            <Run Text="{Binding Title, Mode=OneWay}" /> · <Run Text="{Binding Salaries.Count, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Salaries}" SelectedItem="{Binding SelectedSalary}" VerticalContentAlignment="Center">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Nhân Sự" Width="1.8*"
              Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Avatar}" Margin="0,0,8,0" VerticalAlignment="Center">
                      <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding User.FullName}" FontWeight="Normal" />
                      <TextBlock Text="{Binding User.Role, Converter={StaticResource EnumText}}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Kỳ Lương" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Lương Cơ Bản" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding BaseSalary, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Phụ Cấp" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Allowance, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Thưởng" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Bonus, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Khấu Trừ" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Deduction, StringFormat={}{0:N0} đ}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Thực Lĩnh" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TotalSalary, StringFormat={}{0:N0} đ}" FontWeight="Normal" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Trạng Thái" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Badge}" VerticalAlignment="Center" DataContext="{Binding IsPaid}">
                    <TextBlock FontSize="12" FontWeight="Normal" Foreground="{Binding Converter={StaticResource StatusForeground}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Chưa Thanh Toán" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="True">
                              <Setter Property="Text" Value="Đã Thanh Toán" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ngày Chi" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PaidAt, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ghi Chú" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Note}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Thao Tác" Width="120"
              Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                      Command="{Binding DataContext.TogglePaidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Đánh Dấu Đã / Chưa Chi">
                      <materialDesign:PackIcon Kind="CashCheck" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                      Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Chỉnh Sửa">
                      <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="4,0,0,0"
                      Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}" ToolTip="Xóa">
                      <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{StaticResource DangerBrush}" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </materialDesign:Card>
    <materialDesign:Card Grid.Column="1" Style="{StaticResource PageCard}" Width="350"
      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CancelEditCommand}" ToolTip="Đóng">
            <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
          </Button>
          <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ComboBox ItemsSource="{Binding EligibleUsers}" SelectedValue="{Binding EditUserId}" SelectedValuePath="Id"
          materialDesign:HintAssist.Hint="Nhân Viên / Giáo Viên *" Margin="0,0,0,22">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding FullName, Mode=OneWay}" /> (<Run Text="{Binding Role, Mode=OneWay, Converter={StaticResource EnumText}}" />)
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <DatePicker x:Name="EditorDatePicker" SelectedDate="{Binding EditPeriodDate}" materialDesign:HintAssist.Hint="Kỳ Lương *" Margin="0,0,0,22" />
        <TextBox Text="{Binding BaseSalary, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Lương Cơ Bản (VNĐ) *" Margin="0,0,0,22"
          materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="Cash" />
        <TextBox Text="{Binding Allowance, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Phụ Cấp (VNĐ)" Margin="0,0,0,22"
          materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="PlusCircleOutline" />
        <TextBox Text="{Binding Bonus, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Thưởng (VNĐ)" Margin="0,0,0,22"
          materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="StarOutline" />
        <TextBox Text="{Binding Deduction, StringFormat={}{0:N0}}" materialDesign:HintAssist.Hint="Khấu Trừ (VNĐ)" Margin="0,0,0,22"
          materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="MinusCircleOutline" />
        <TextBox Text="{Binding Note}" materialDesign:HintAssist.Hint="Ghi Chú" Margin="0,0,0,26" />
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" ToolTip="Lưu" HorizontalAlignment="Right">
          <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" />
        </Button>
      </StackPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>