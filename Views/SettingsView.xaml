<UserControl x:Class="EduFlow.WPF.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <materialDesign:Card Style="{StaticResource PageCard}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,32" Padding="32,28">
        <StackPanel>
          <Border Style="{StaticResource Avatar}" Width="92" Height="92" CornerRadius="46" Background="#EFF6FF" HorizontalAlignment="Center" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Account" Foreground="{StaticResource PrimaryBrush}" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding FullName}" FontSize="22" FontWeight="Normal" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
          <Border Style="{StaticResource Badge}" HorizontalAlignment="Center" Margin="0,8,0,28" DataContext="{Binding Role}">
            <TextBlock Style="{StaticResource BadgeText}" FontSize="13" />
          </Border>
          <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" Padding="24,18">
            <StackPanel>
              <DockPanel Margin="0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <materialDesign:PackIcon Kind="AccountCircleOutline" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" VerticalAlignment="Center" />
                  <TextBlock Text="Tên Đăng Nhập" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Username}" FontWeight="Normal" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
              <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
              <DockPanel Margin="0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <materialDesign:PackIcon Kind="PhoneOutline" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" VerticalAlignment="Center" />
                  <TextBlock Text="Số Điện Thoại" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Phone}" FontWeight="Normal" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
              <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
              <DockPanel Margin="0,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <materialDesign:PackIcon Kind="EmailOutline" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" VerticalAlignment="Center" />
                  <TextBlock Text="Email" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Email}" FontWeight="Normal" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenChangePasswordCommand}" Height="44" Margin="0,28,0,0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <materialDesign:PackIcon Kind="KeyOutline" Width="20" Height="20" VerticalAlignment="Center" />
              <TextBlock Text="Đổi Mật Khẩu" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </materialDesign:Card>
    </ScrollViewer>
    <Grid Background="#66000000" Visibility="{Binding IsChangePasswordOpen, Converter={StaticResource BoolToVisibility}}">
      <materialDesign:Card Style="{StaticResource PageCard}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
        <StackPanel>
          <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CloseChangePasswordCommand}" ToolTip="Đóng">
              <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource MutedBrush}" Width="20" Height="20" />
            </Button>
            <TextBlock Text="Đổi Mật Khẩu" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <TextBox Text="{Binding OldPassword}" materialDesign:HintAssist.Hint="Mật Khẩu Hiện Tại *"
            materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="LockOutline" Margin="0,0,0,24" />
          <TextBox Text="{Binding NewPassword}" materialDesign:HintAssist.Hint="Mật Khẩu Mới *"
            materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="KeyOutline" Margin="0,0,0,24" />
          <TextBox Text="{Binding ConfirmPassword}" materialDesign:HintAssist.Hint="Xác Nhận Mật Khẩu Mới *"
            materialDesign:TextFieldAssist.HasLeadingIcon="True" materialDesign:TextFieldAssist.LeadingIcon="CheckCircleOutline"
            Margin="0,0,0,28" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" />
              <TextBlock Text="Xác Nhận" Margin="6,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
      </materialDesign:Card>
    </Grid>
  </Grid>
</UserControl>