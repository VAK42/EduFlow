<Window x:Class="EduFlow.WPF.Views.LoginWindow" Language="vi-VN"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  Title="EduFlow - Đăng Nhập" Height="540" Width="900"
  WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
  Background="White" TextElement.FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource BrandGradient}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="16" Background="#33FFFFFF" HorizontalAlignment="Center">
          <materialDesign:PackIcon Kind="School" Width="36" Height="36" Foreground="White"
            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="EduFlow" Foreground="White" FontSize="30" FontWeight="Normal" Margin="0,16,0,0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="64,0">
      <TextBlock Text="Đăng Nhập" FontSize="28" FontWeight="Normal" Foreground="{StaticResource TextBrush}" />
      <TextBlock Text="Nhập Tài Khoản Được Trung Tâm Cấp Để Tiếp Tục" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20" />
      <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
        materialDesign:HintAssist.Hint="Tên Đăng Nhập"
        materialDesign:TextFieldAssist.HasLeadingIcon="True"
        materialDesign:TextFieldAssist.LeadingIcon="Account" />
      <PasswordBox x:Name="PasswordInput" Margin="0,16,0,0"
        materialDesign:HintAssist.Hint="Mật Khẩu"
        materialDesign:TextFieldAssist.HasLeadingIcon="True"
        materialDesign:TextFieldAssist.LeadingIcon="Lock" />
      <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
        <StackPanel Orientation="Horizontal">
          <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
      <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Height="44" IsDefault="True"
        Click="LoginButton_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Đăng Nhập" Foreground="White" FontSize="15" />
        </StackPanel>
      </Button>
      <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Height="3"
        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </Grid>
</Window>